<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 auto;">
  <tr>
    <td align="center">
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px; background-color:#FFF8ED; border:3px solid #B84A1B; border-radius:14px; overflow:hidden; font-family:Arial, Helvetica, sans-serif;">
        <tr>
          <td style="height:8px; background-color:#D97726; font-size:0; line-height:0;">&nbsp;</td>
        </tr>

        <tr>
          <td align="center" style="background-color:#13263F; padding:22px 20px 18px 20px;">
      
          
            <div style="font-size:27px; line-height:32px; font-weight:900; color:#FFFFFF; margin-top:8px;">
              🚨 2026 HOUSE FALL<br>PRIORITIES SURVEY 🚨
            </div>
          </td>
        </tr>

        <tr>
          <td style="padding:22px 24px 8px 24px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td style="padding:13px 15px; background-color:#F4E5CF; border-left:5px solid #B84A1B;">
                  <div style="font-size:11px; letter-spacing:1.5px; font-weight:bold; color:#7A4B2A; text-transform:uppercase;">
                    RESPONDENT
                  </div>

                  <div style="font-size:20px; line-height:25px; font-weight:900; color:#13263F; padding-top:3px;">
                    ${Recipient.FIRST_NAME}
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:8px 24px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td align="center" style="background-color:#B84A1B; padding:13px 15px; border-radius:6px;">
                  <div style="font-size:11px; letter-spacing:1.5px; font-weight:bold; color:#FFE8CF; text-transform:uppercase;">
                    TIME LEFT
                  </div>

                  <div style="font-size:25px; line-height:29px; font-weight:900; color:#FFFFFF;">
                    ⏳ 60 MINUTES
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:8px 24px 15px 24px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border:2px dashed #C98B4B;">
              <tr>
                <td align="center" style="padding:17px 18px;">
                  <div style="font-size:11px; line-height:15px; letter-spacing:2px; font-weight:bold; color:#B84A1B; text-transform:uppercase;">
                    MISSION
                  </div>

                  <div style="font-size:18px; line-height:25px; font-weight:800; color:#13263F; padding-top:6px;">
                    Tell us what MAGA supporters<br>
                    want prioritized this fall.
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td align="center" style="padding:4px 24px 25px 24px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
              <tr>
                <td align="center" bgcolor="#B84A1B" style="border-radius:6px;">
                  <a href="{{link}}" style="display:inline-block; padding:16px 34px; font-family:Arial, Helvetica, sans-serif; font-size:18px; line-height:20px; font-weight:900; color:#FFFFFF; text-decoration:none; letter-spacing:0.5px;">
                    TAKE IT NOW &gt;&gt;
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>


